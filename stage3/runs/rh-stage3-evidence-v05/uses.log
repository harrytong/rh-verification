theorem SelfIntersectionVolumeEstimates.topCovolG_alt_alt : SelfIntersectionVolumeEstimates.VolumeEstimateHypotheses →
  GlobalTheory.CovTop.HypothesesX →
    GlobalTheory.CovTop.PublishedHodgeBundleTheorems →
      GlobalTheory.CovHt.HypothesesH →
        GlobalTheory.Published.GrothendieckDeformation →
          GlobalTheory.HSCore.Quoted →
            GlobalTheory.CompanionTheory.Ar.Plug.DeepStR → GlobalTheory.CovTop.CovolumeBoundOfX :=
fun (hSB : SelfIntersectionVolumeEstimates.VolumeEstimateHypotheses) (hX : GlobalTheory.CovTop.HypothesesX)
    (hP : GlobalTheory.CovTop.PublishedHodgeBundleTheorems) (hH : GlobalTheory.CovHt.HypothesesH)
    (hGD : GlobalTheory.Published.GrothendieckDeformation) (hQ : GlobalTheory.HSCore.Quoted)
    (hD : GlobalTheory.CompanionTheory.Ar.Plug.DeepStR) =>
  have hS : GlobalTheory.Published.SiegelToroidalIntegral := GlobalTheory.CovHt.HypothesesH.sieg hH;
  have hK : GlobalTheory.Published.ToroidalForFanKS := GlobalTheory.CovTop.HypothesesX.ks hX;
  have hN : GlobalTheory.Published.SemiAbelianLieSeminegative := GlobalTheory.CovTop.HypothesesX.lie hX;
  have gram : GlobalTheory.CovTop.GramCondition := GlobalTheory.T.covering_gram_of_prints hP;
  have size : GlobalTheory.CovTop.SizeCondition := GlobalTheory.T.cov_size_bound;
  have meas : GlobalTheory.CovTop.MeasureCondition := GlobalTheory.T.covering_meas_of_prints hP;
  have anc : GlobalTheory.CovTop.AnchorCondition := GlobalTheory.T.anchor_bound;
  have dex : GlobalTheory.CovTop.DeepExistence := GlobalTheory.T.covering_deepEx_of_prints hP;
  have dg : GlobalTheory.CovTop.DeepGoodness := GlobalTheory.T.deepGood_of_toroidal_and_semiabelian hP hGD hQ hS hK hN;
  have fd : GlobalTheory.CovTop.FlatDegreeCondition := GlobalTheory.T.flatDeg_of_scholzeWeinstein_of_prints hP;
  have deg : GlobalTheory.CovTop.CoverDegree :=
    GlobalTheory.T.coverDegree_of_grothendieck_deformation hX hP hS hK hGD hQ hN dg size fd;
  have sh : GlobalTheory.CovTop.ShareCondition :=
    GlobalTheory.T.share_of_deep_good_size_flat_deg_cover_degree hX hP hS hK hGD hQ hN dg size fd deg;
  have ht : GlobalTheory.CovTop.HeightCondition :=
    SelfIntersectionVolumeEstimates.height_lower_bound_general_alt hSB hX hGD hQ hP hH hD dg size deg fd;
  have hs : GlobalTheory.CovTop.CoverHeightSum :=
    GlobalTheory.T.coverHeightSum_of_flatDeg_coverDegree_share hX hP hGD hQ hS hK hN dg size fd deg sh;
  have ul : GlobalTheory.CovTop.UniformLowerBound :=
    GlobalTheory.T.uniform_lower_bound_of_sums' dg size deg sh ht hs (GlobalTheory.T.sum_c_of_deep_good dg);
  have low : GlobalTheory.CovTop.LiftLowBound :=
    GlobalTheory.T.liftLowBound_of_cover_estimates size (GlobalTheory.T.lowDef_of_gram_of_anchor hP gram anc) dex dg
      (GlobalTheory.T.covering_ring_of_prints_gram_deepGood hP gram dg)
      (GlobalTheory.T.covering_maps_of_gram_deep_size_flatDeg hP hGD hQ hS hK hN gram dg size fd)
      (GlobalTheory.T.coverRank_of_coverDegree_and_share hX hP hGD hQ hS hK hN dg size fd deg sh)
      (GlobalTheory.T.covering_gmin_of_prints_gram_deep_size hP gram dg size)
      (GlobalTheory.T.flat_of_prints_deepGood_flatDeg_anchor hP dg fd anc) ul;
  GlobalTheory.T.covolX_of_truncation_badSet_lambda_lowBound gram (GlobalTheory.T.lift_recursion_of_gram_bound gram)
    (GlobalTheory.T.liftTruncation_of_prints hP)
    (GlobalTheory.T.liftBadSet_of_deep_size_flatDeg_share hX hP hGD hQ hS hK hN
      (GlobalTheory.CovTop.HypothesesX.green hX) gram dex dg size fd deg sh)
    (GlobalTheory.T.liftLambdaBound_of_gram_meas hP gram meas) size
    (GlobalTheory.T.coreLe_of_gram_meas_liftRational gram meas (GlobalTheory.T.liftRational_of_prints hP)) low
