riemannHypothesis : RiemannHypothesis
def RiemannHypothesis : Prop :=
∀ (s : ℂ),
  Eq.{1} (riemannZeta s) 0 →
    (¬∃ n, Eq.{1} s (HMul.hMul.{0, 0, 0} (-2) (HAdd.hAdd.{0, 0, 0} (↑n) 1))) → Ne.{1} s 1 → Eq.{1} s.re (1 / 2)
